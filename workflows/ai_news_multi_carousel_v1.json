                "jsCode": "\nconst now = new Date();\nconst dayOfWeek = now.getDay(); // 0=Sun, 1=Mon...6=Sat\nconst isWeekend = (dayOfWeek === 0 || dayOfWeek === 6);\n\n// Category rotation for weekdays\nconst categories = {\n    1: 'gaming',      // Monday\n    2: 'history',     // Tuesday\n    3: 'politics',    // Wednesday\n    4: 'physics',     // Thursday\n    5: 'ai_research'  // Friday\n};\n\nconst items = $input.all();\n\nreturn items.map(item => ({\n    json: {\n        ...item.json,\n        isWeekend: isWeekend,\n        dayOfWeek: dayOfWeek,\n        todayCategory: categories[dayOfWeek] || 'tech'\n    }\n}));\n"
