            "name": "Pick Top 3 Articles",
            "type": "n8n-nodes-base.limit",
            "typeVersion": 1,
            "position": [
                1250,
                200
            ],
            "notes": "Selects the single most recent article for today's post"
        },
        {
            "parameters": {
                "method": "POST",
                "url": "https://openrouter.ai/api/v1/chat/completions",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        },
                        {
                            "name": "Authorization",
                            "value": "Bearer YOUR_OPENROUTER_API_KEY_HERE"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={\n  \"model\": \"openai/gpt-4o-mini\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a top-tier Instagram creator building high-performance news posts. Given the news snippet, output a JSON structure for 2 slides (Hook slide, Detail slide).\\n\\nReturn EXACTLY this JSON structure:\\n{\\n  \\\"hook_slide\\\": {\\n    \\\"image_prompt\\\": \\\"(A highly detailed visual description targeting a FLUX.1 high-end AI image generator depicting the news subject explicitly, e.g. 'Elon Musk standing in an intricate SpaceX mission control room, futuristic holograms, masterpiece photography, cinematic lighting, breathtaking detail, 8k resolution, NO TEXT IN IMAGE')\\\",\\n    \\\"text\\\": \\\"(A massive viral Hook in ALL CAPS. Wrap the most important 1-3 words in <c> and </c> tags for orange highlighting)\\\"\\n  },\\n  \\\"detail_slide\\\": {\\n    \\\"headline\\\": \\\"(Short headline)\\\",\\n    \\\"what_is_it\\\": \\\"(1-2 clear sentences explaining the concept)\\\",\\n    \\\"how_it_helps\\\": \\\"(1-2 clear sentences on the benefits)\\\",\\n    \\\"implication\\\": \\\"(1-2 sentences covering the broader impact)\\\"\\n  },\\n  \\\"caption\\\": \\\"(A mega-caption summarizing the story)\\\",\\n  \\\"hashtags\\\": \\\"#tech\\\"\\n}\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify(\"Title: \" + $json.title + \"\\nSnippet: \" + (($json.contentSnippet || $json.content) || \"\").substring(0, 2000)) }}\n    }\n  ],\n  \"response_format\": { \"type\": \"json_object\" }\n}",
                "options": {
                    "timeout": 60000
                }
            },
            "id": "a1000001-0000-0000-0000-000000000010",
            "name": "AI Content Generator",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                1250,
                200
            ],
            "notes": "Uses OpenRouter API with GPT-4o-mini. Generates hook, caption, imagePrompt, hashtags."
        },
        {
            "parameters": {
                "jsCode": "\nconst results = [];\nconst articles = $('Pick Top 3 Articles').all();\nconst aiResponses = $input.all();\n\nfor (let i = 0; i < aiResponses.length; i++) {\n    const inputData = aiResponses[i].json;\n    const article = (articles && articles[i]) ? articles[i].json : {};\n    \n    try {\n        let rawContent = \"\";\n        if (inputData.choices && inputData.choices[0]) {\n            const msg = inputData.choices[0].message;\n            rawContent = msg.content || msg.reasoning || \"\";\n        }\n        \n        let cleanContent = rawContent.replace(/```json/g, \"\").replace(/```/g, \"\").trim();\n        const parsed = JSON.parse(cleanContent);\n        \n        parsed.originalTitle = article.title;\n        parsed.originalLink = article.link;\n        parsed.originalImage = article.imageUrl;\n        \n        results.push({ json: parsed });\n    } catch (e) {\n        results.push({\n            json: {\n                hook: \"TECH JUST CHANGED FOREVER\",\n                caption: \"Failed to parse: \" + e.message,\n                hashtags: \"#tech\",\n                originalTitle: article.title,\n                originalLink: article.link,\n                originalImage: article.imageUrl,\n                error: e.message\n            }\n        });\n    }\n}\nreturn results;\n"
            },
            "id": "a1000001-0000-0000-0000-000000000011",
            "name": "Parse AI Response",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1500,
                200
            ],
            "notes": "Parses OpenRouter JSON response. Falls back to safe defaults if parsing fails."
        },
        {
            "parameters": {
                "jsCode": "const staticData = $getWorkflowStaticData('global');\nstaticData.postedUrls = staticData.postedUrls || [];\nconst aggr = $('Aggregate News').first().json;\nif (aggr && aggr.articleLinks) {\n    for (const link of aggr.articleLinks) {\n       staticData.postedUrls.push(link);\n    }\n    while(staticData.postedUrls.length > 300) {\n        staticData.postedUrls.shift();\n    }\n}\n\nconst result = $input.first().json;\nreturn [{\n  json: {\n    status: '\u2705 SUCCESS',\n    message: 'Instagram Reel published successfully!',\n    postId: result.id || 'unknown',\n    postedAt: new Date().toISOString(),\n    hook: $('Parse AI Response').first().json.hook\n  }\n}];"
            },
            "id": "a1000001-success",
            "name": "Success Handler",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                3500,
                200
            ]
        },
        {
            "parameters": {
                "jsCode": "const error = $input.first().json;\nreturn [{\n  json: {\n    status: '\u274c ERROR',\n    message: 'Workflow failed',\n    error: error.message || JSON.stringify(error),\n    timestamp: new Date().toISOString()\n  }\n}];"
            },
            "id": "a1000001-error",
            "name": "Error Handler",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                3500,
                450
            ]
        },
        {
            "parameters": {
                "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst postedUrls = staticData.postedUrls || [];\n\nconst unseen = $input.all().filter(item => !postedUrls.includes(item.json.link));\n\nif (unseen.length < 3) {\n    // If we run out of new articles, reset memory loop\n    staticData.postedUrls = [];\n    return $input.all();\n}\n\nreturn unseen;"
            },
            "id": "a1000001-filter-dups",
            "name": "Filter Posted Articles",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                750,
                200
            ]
        },
        {
            "parameters": {
                "jsCode": "\nconst items = $input.all().map(item => item.json);\nlet finalCaption = \"\ud83d\udd25 TODAY'S TOP TECH NEWS DIGEST\\n\\n\";\nconst slides = [];\nconst articleLinks = [];\n\nconst tracks = ['memory reboot', 'the lost soul down', 'snowfall', 'after dark'];\nconst randomTrack = tracks[Math.floor(Math.random() * tracks.length)];\n\nfor (let i = 0; i < items.length; i++) {\n    const news = items[i];\n    \n    // Safely extract text strips from objects\n    let hookText = news.hook_slide ? news.hook_slide.text : (news.hook || news.originalTitle);\n    hookText = hookText.replace(/<[^>]*>?/gm, ''); // strip XML tags for pure caption\n    \n    finalCaption += `\ud83d\udcf0 ${hookText} \\n ${news.caption}\\n\ud83d\udd17 ${news.originalLink}\\n\\n`;\n    \n    // Add Cover Slide\n    slides.push({\n        type: 'hook',\n        image_prompt: news.hook_slide ? news.hook_slide.image_prompt : (news.search_query || news.originalTitle),\n        text: news.hook_slide ? news.hook_slide.text : (news.hook || news.originalTitle)\n    });\n    \n    // Add Detail Slide\n    slides.push({\n        type: 'detail',\n        headline: news.detail_slide ? news.detail_slide.headline : 'Details',\n        what_is_it: news.detail_slide ? news.detail_slide.what_is_it : '',\n        how_it_helps: news.detail_slide ? news.detail_slide.how_it_helps : '',\n        implication: news.detail_slide ? news.detail_slide.implication : ''\n    });\n    \n    articleLinks.push(news.originalLink);\n}\nfinalCaption += \"#tech #news #updates #artificialintelligence #startup #innovation\";\n\nreturn [{\n    json: {\n        song_name: randomTrack,\n        slides: slides,\n        finalCaption: finalCaption,\n        articleLinks: articleLinks\n    }\n}];\n"
            },
