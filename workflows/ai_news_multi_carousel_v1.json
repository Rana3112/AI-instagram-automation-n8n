            "name": "Day of Week Check",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                850,
                200
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "boolean": [
                        {
                            "value1": "={{ $json.isWeekend }}",
                            "value2": true
                        }
                    ]
                }
            },
            "id": "v16-if-weekend",
            "name": "Is Weekend?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 2,
            "position": [
                1050,
                200
            ]
        },
        {
            "parameters": {
                "jsCode": "\nconst items = $input.all();\n\n// Just pick the very first (most recent) article\nconst top = items[0];\n\nreturn [{\n    json: {\n        title: top.json.title,\n        contentSnippet: top.json.contentSnippet || top.json.content || '',\n        link: top.json.link,\n        category: top.json.todayCategory || 'tech'\n    }\n}];\n"
            },
            "id": "v16-pick-one",
            "name": "Pick 1 Article",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1250,
                500
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "https://openrouter.ai/api/v1/chat/completions",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "Bearer {{ $env.OPENROUTER_API_KEY }}"
                        },
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={\n  \"model\": \"openai/gpt-4o-mini\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a top-tier Instagram creator building high-performance single-topic posts. For the provided news snippet, output a highly structured JSON for 2 slides.\\n\\nReturn EXACTLY this JSON structure:\\n{\\n  \\\"hook_slide\\\": {\\n    \\\"image_prompt\\\": \\\"(A highly detailed visual description targeting a FLUX.1 high-end AI image generator depicting the news subject explicitly, e.g. 'Sundar Pichai giving a presentation surrounded by massive holographic AI neural networks, masterpiece photography, cinematic lighting, breathtaking detail, 8k resolution, NO TEXT IN IMAGE')\\\",\\n    \\\"text\\\": \\\"(A massive viral Hook in ALL CAPS. Wrap the most important 1-3 words in <c> and </c> tags for orange highlighting)\\\"\\n  },\\n  \\\"detail_slide\\\": {\\n    \\\"headline\\\": \\\"(Short numbered headline)\\\",\\n    \\\"what_is_it\\\": \\\"(1-2 clear sentences explaining the concept)\\\",\\n    \\\"how_it_helps\\\": \\\"(1-2 clear sentences on the benefits)\\\",\\n    \\\"implication\\\": \\\"(1-2 sentences covering the broader impact)\\\"\\n  },\\n  \\\"caption\\\": \\\"(A punchy Instagram post caption)\\\",\\n  \\\"hashtags\\\": \\\"#tech \\\"\\n}\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify(\"Title: \" + $json.title + \"\\nSnippet: \" + (($json.contentSnippet || $json.content) || \"\").substring(0, 2000)) }}\n    }\n  ],\n  \"response_format\": { \"type\": \"json_object\" }\n}",
                "options": {
                    "timeout": 30000
                }
            },
            "id": "v16-ai-single",
            "name": "AI Single Post Generator",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                1500,
                500
            ]
        },
        {
            "parameters": {
                "jsCode": "\nconst raw = $json;\nconst messageContent = raw.choices[0].message.content;\nlet parsed;\ntry {\n    parsed = JSON.parse(messageContent);\n} catch(e) {\n    const match = messageContent.match(/\\{[\\s\\S]*\\}/);\n    parsed = match ? JSON.parse(match[0]) : {};\n}\nreturn [{\n    json: {\n        ...parsed,\n        originalTitle: $('Pick 1 Article').first().json.title,\n        originalLink: $('Pick 1 Article').first().json.link\n    }\n}];\n"
            },
            "id": "v16-parse-single",
            "name": "Parse Single AI Response",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1750,
                500
            ]
        },
        {
            "parameters": {
                "jsCode": "\nconst news = $json;\nconst tracks = ['memory reboot', 'the lost soul down', 'snowfall', 'after dark'];\nconst randomTrack = tracks[Math.floor(Math.random() * tracks.length)];\n\nlet hookText = news.hook_slide ? news.hook_slide.text : news.originalTitle;\nlet cleanHook = hookText.replace(/<[^>]*>?/gm, '');\n\nconst finalCaption = `${cleanHook}\\n\\n${news.caption || ''}\\n\\n${news.hashtags || '#tech #news'}\\n\\n\ud83d\udd17 ${news.originalLink}`;\n\nconst slides = [\n    {\n        type: 'hook',\n        image_prompt: news.hook_slide ? news.hook_slide.image_prompt : news.originalTitle,\n        text: news.hook_slide ? news.hook_slide.text : news.originalTitle\n    },\n    {\n        type: 'detail',\n        headline: news.detail_slide ? news.detail_slide.headline : 'Details',\n        what_is_it: news.detail_slide ? news.detail_slide.what_is_it : '',\n        how_it_helps: news.detail_slide ? news.detail_slide.how_it_helps : '',\n        implication: news.detail_slide ? news.detail_slide.implication : ''\n    }\n];\n\nreturn [{\n    json: {\n        song_name: randomTrack,\n        slides: slides,\n        finalCaption: finalCaption,\n        articleLinks: [news.originalLink]\n    }\n}];\n"
            },
            "id": "v16-build-single",
            "name": "Build Single Post Data",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                2000,
                500
            ]
        },
        {
            "parameters": {
                "mode": "append",
                "numberInputs": 10
            },
            "id": "v16-merge-categories",
            "name": "Merge New Category Feeds",
            "type": "n8n-nodes-base.merge",
            "typeVersion": 3,
            "position": [
                100,
                900
            ]
        }
    ],
