        {
            "parameters": {
                "jsCode": "// Normalize NewsAPI articles to match RSS feed format\nconst articles = $input.first().json.articles || [];\n\nreturn articles\n  .filter(a => a.title && a.title !== '[Removed]')\n  .slice(0, 5)\n  .map(a => ({\n    json: {\n      title: a.title,\n      link: a.url,\n      content: a.description || '',\n      contentSnippet: a.description || '',\n      pubDate: a.publishedAt,\n      imageUrl: a.urlToImage,\n      source: a.source?.name || 'NewsAPI'\n    }\n  }));"
            },
            "id": "a1000001-0000-0000-0000-000000000006",
            "name": "Format NewsAPI Output",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                0,
                0
            ]
        },
