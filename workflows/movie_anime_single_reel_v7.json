                "jsonBody": "={\n  \"model\": \"openai/gpt-4o-mini\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are IGN's top Instagram creator. For the provided movie/anime/gaming news, output EXACTLY ONE slide.\\n\\nReturn THIS JSON structure:\\n{\\n  \\\"hook_slide\\\": {\\n    \\\"image_prompt\\\": \\\"(A hyper-detailed cinematic description for an AI image generator depicting the movie/anime subject, masterpiece, 8k, cinematic lighting, NO TEXT IN IMAGE)\\\",\\n    \\\"text\\\": \\\"(A massive viral headline in ALL CAPS. Wrap the most important 1-3 words in <c> and </c> tags for orange highlighting)\\\",\\n    \\\"subtext\\\": \\\"(A short 1-2 sentence description explaining what the title actually means in normal casing. Do NOT use tags here.)\\\"\\n  },\\n  \\\"caption\\\": \\\"(A punchy IG caption summarizing the movie news)\\\",\\n  \\\"hashtags\\\": \\\"#movies #anime #ign\\\"\\n}\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify(\"Title: \" + $json.title + \"\\nSnippet: \" + (($json.contentSnippet || $json.content) || \"\").substring(0, 2000)) }}\n    }\n  ],\n  \"response_format\": { \"type\": \"json_object\" }\n}",
                "options": {
                    "timeout": 30000
                }
            },
