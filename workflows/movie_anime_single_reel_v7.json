        {
            "parameters": {
                "jsCode": "\nconst slides = [];\nlet finalCaption = '\ud83d\udd25 WEEKEND MOVIE ROUNDUP \ud83d\udd25\\n\\n';\n\n// The Parse node already did the extraction natively! No need to JSON.parse!\nconst topItem = $input.all()[0].json;\n\n// 1. Force the single 1-Image IGN Hook target\nslides.push({\n  type: 'hook',\n  image_prompt: topItem.hook_slide ? topItem.hook_slide.image_prompt : \"futuristic cinematic abstract movie background\",\n  text: topItem.hook_slide ? topItem.hook_slide.text : \"MAJOR UPDATE\",\n  subtext: topItem.hook_slide ? (topItem.hook_slide.subtext || \"\") : \"\"\n});\n\n// 2. Aggregate the Captions from all 3 inputs naturally\nlet tags = \"\";\nfor (let i=0; i < $input.all().length; i++) {\n  const content = $input.all()[i].json;\n  finalCaption += `\ud83c\udfac STORY ${i+1}:\\n${content.caption || \"Breaking News!\"}\\n\\n`;\n  if (content.hashtags) { tags += content.hashtags + \" \"; }\n}\n\nfinalCaption += tags;\n\nreturn {\n  json: {\n    slides: slides,\n    finalCaption: finalCaption\n  }\n};\n"
            },
